# Copy to .env and fill in. Never committed.

# ntfy: base URL of the server (without the topic) + topic + access token
NTFY_URL=http://192.168.1.x:8080
NTFY_TOPIC=hdd-deals
NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# eBay Browse API (developer.ebay.com > My Account > Application Keys, Production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production

# Optional
TZ=Europe/Paris
LISTINGWATCHER_CONFIG=/app/config.yaml
LISTINGWATCHER_DB=/data/listingwatcher.sqlite
LOG_LEVEL=INFO
